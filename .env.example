# Nebius Token Factory
NEBIUS_API_KEY=your_nebius_api_key_here
TF_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TF_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
TF_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
TF_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
TF_MODEL_AGENT=nvidia/nemotron-3-super-120b-a12b

# Model Prices per 1M tokens (USD)
PRICE_NANO_IN=0.06
PRICE_NANO_OUT=0.24
PRICE_SUPER_IN=0.30
PRICE_SUPER_OUT=0.90
PRICE_ULTRA_IN=1.00
PRICE_ULTRA_OUT=3.00

# Guards
SPEND_CAP_USD=35
RUNS_PER_IP_PER_HOUR=6

# Neon Database (Postgres)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/warden?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/warden?sslmode=require"

# Approver and Security
APPROVER_PASSCODE=warden-demo-passcode-2026
SESSION_SECRET=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
DEMO_AGENT_KEY=warden-demo-agent-key-2026

# App Config
NEXT_PUBLIC_APP_NAME=Warden
